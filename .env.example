# Chaîne de connexion de ton cluster MongoDB Atlas (M0, gratuit à vie).
# Exemple : mongodb+srv://utilisateur:motdepasse@cluster0.xxxxx.mongodb.net/proclamations
MONGODB_URI=

# Mot de passe pour accéder au tableau de bord responsable.
ADMIN_PASSWORD=change-moi

# Clé secrète utilisée pour signer les cookies de connexion (une longue chaîne aléatoire).
SESSION_SECRET=change-moi-aussi
